*.ps              binary
*.eps             binary
*.epub            binary
*.mobi            binary
*.djvu            binary
*.doc             binary
*.docx            binary
*.xls             binary
*.xlsx            binary
*.ppt             binary
*.pptx            binary
*.odt             binary
*.ods             binary
*.odp             binary

# ================================================================
# Raster Images, Icons & Design Assets
# ================================================================
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.webp            binary
*.avif            binary
*.ico             binary
*.bmp             binary
*.tiff            binary
*.psd             binary
*.xcf             binary

# ================================================================
# Audio, Video & Typography
# ================================================================
*.mp3             binary
*.wav             binary
*.ogg             binary
*.flac            binary
*.mp4             binary
*.mkv             binary
*.avi             binary
*.mov             binary
*.webm            binary
*.ttf             binary
*.otf             binary
*.woff            binary
*.woff2           binary
*.eot             binary

# ================================================================
# Archives, Binaries, Databases & Cryptographic Keys
# ================================================================
*.zip             binary
*.tar             binary
*.gz              binary
*.tgz             binary
*.xz              binary
*.bz2             binary
*.7z              binary
*.rar             binary
*.zst             binary
*.exe             binary
*.dll             binary
*.so              binary
*.dylib           binary
*.bin             binary
*.o               binary
*.a               binary
*.pyc             binary
*.elc             binary
*.eln             binary
*.wasm            binary
*.sqlite          binary
*.sqlite3         binary
*.db              binary
*.pem             binary
*.crt             binary
*.key             binary
*.p12             binary
*.age             binary
*.gpg             binary
*.ppk             binary

# ================================================================
# Release & Archive Exclusions (git archive)
# ================================================================
.gitattributes    export-ignore
.gitignore        export-ignore
.editorconfig     export-ignore
.github/          export-ignore
.scripts/         export-ignore
.agents/          export-ignore
.githooks/        export-ignore
