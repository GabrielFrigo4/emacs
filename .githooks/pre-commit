#!/usr/bin/env sh

### ================================
### EMACS PRE-COMMIT HOOK
### ================================

set -eu

_fail() {
    echo "❌ [pre-commit] $*" >&2
    exit 1
}

### --------------------------------
### Repo sanity
### --------------------------------
git rev-parse --git-dir > "/dev/null" 2>&1 \
    || _fail "Not inside a valid Git repository."

_guard_bare() {
    if [ "$(git config --get core.bare || true)" = "true" ] \
        && git config --get core.worktree > "/dev/null" 2>&1; then
        echo "⚠️  [pre-commit] core.bare=true com core.worktree definido (${1}); restaurando core.bare=false." >&2
        git config core.bare false
    fi
}
_guard_bare "início do hook"

_repo_root="$(git rev-parse --show-toplevel)" \
    || _fail "Could not resolve the work tree root."
cd "${_repo_root}"

_tmp="$(mktemp -d "${TMPDIR:-/tmp}/emacs-precommit.XXXXXX")" \
    || _fail "Could not create a temporary directory."
trap 'rm -rf "${_tmp}"' EXIT
trap 'exit 1' HUP INT TERM

_tab="$(printf '\t')"

echo "🔍 [pre-commit] Executing Emacs quality & syntax gates..."

### --------------------------------
### Anything staged?
### --------------------------------
_rc=0
git diff --cached --quiet || _rc=$?
case "${_rc}" in
    0)
        echo "ℹ️  [pre-commit] Nothing staged, skipping gates."
        exit 0
        ;;
    1) ;;
    *)
        _fail "'git diff --cached' failed (exit ${_rc}). Index or objects may be corrupted. Run: git fsck --full"
        ;;
esac

### --------------------------------
### Index / Object Integrity
### --------------------------------
echo "  ↳ Checking index integrity (git write-tree)..."
if ! git write-tree > "/dev/null"; then
    _fail "Index is inconsistent, has conflicts, or references missing objects. Run: git fsck --full"
fi

### --------------------------------
### Whitespace & Formatting Check
### --------------------------------
echo "  ↳ Checking whitespace and formatting (git diff --check)..."
if ! git diff --check --cached; then
    echo "❌ [pre-commit] Whitespace or EOF formatting error detected!" >&2
    echo "    Run 'git diff --check --cached' to inspect issues." >&2
    exit 1
fi

### --------------------------------
### Git Index File Modes Check
### --------------------------------
echo "  ↳ Validating Git Index file modes (0755 vs 0644)..."

git -c core.quotepath=false diff --cached --raw --no-abbrev --no-renames \
    --diff-filter=ACMRT > "${_tmp}/raw" \
    || _fail "Could not list staged files."

: > "${_tmp}/md.list"
: > "${_tmp}/sh.list"

_bad_modes=0

_mode_error() {
    echo "❌ [pre-commit] ${1}: ${2}" >&2
    echo "    Execute: git update-index --chmod=${3} \"${2}\"" >&2
    _bad_modes=$((_bad_modes + 1))
}

_has_shebang() {
    git cat-file -e "${1}" \
        || _fail "Missing object ${1} in the repository. Run: git fsck --full"
    [ "$(git cat-file blob "${1}" 2> "/dev/null" \
        | dd bs=1 count=2 2> "/dev/null" \
        | tr -d '\000')" = "#!" ]
}

while IFS="${_tab}" read -r _meta _f; do
    [ -n "${_f}" ] || continue
    set -- ${_meta}
    _mode="${2:-}"
    _sha="${4:-}"

    case "${_mode}" in
        160000 | 120000) continue ;;
    esac

    _base="${_f##*/}"

    case "${_base}" in
        *.md) printf '%s\t%s\n' "${_sha}" "${_f}" >> "${_tmp}/md.list" ;;
        *.sh) printf '%s\t%s\n' "${_sha}" "${_f}" >> "${_tmp}/sh.list" ;;
    esac

    case "${_f}" in
        .githooks/*) _is_hook=1 ;;
        *) _is_hook=0 ;;
    esac

    case "${_base}" in
        *.md | *.txt | *.json | *.yaml | *.yml | *.toml | *.el | *.lua | *.vim | *.ini | *.conf | *.css | *.html | *.svg | *.png | *.jpg | *.sample | .gitignore | .gitmodules | .gitattributes)
            _is_doc=1 ;;
        *) _is_doc=0 ;;
    esac

    case "${_mode}" in
        100755)
            if [ "${_is_hook}" -eq 1 ]; then
                continue
            fi
            case "${_base}" in
                *.cmd | *.ps1 | *.nu | *.bat) continue ;;
            esac
            if ! _has_shebang "${_sha}"; then
                if [ "${_is_doc}" -eq 1 ]; then
                    _mode_error "Arquivo de documentação com bit executável" "${_f}" "-x"
                else
                    _mode_error "Arquivo sem shebang com bit executável" "${_f}" "-x"
                fi
            fi
            ;;
        100644)
            if [ "${_is_hook}" -eq 1 ]; then
                case "${_base}" in
                    *.sample) ;;
                    *) _mode_error "Gancho Git sem permissão de execução" "${_f}" "+x" ;;
                esac
                continue
            fi
            case "${_base}" in
                *.png | *.jpg) continue ;;
            esac
            if _has_shebang "${_sha}"; then
                _mode_error "Script com shebang sem permissão de execução" "${_f}" "+x"
            fi
            ;;
    esac
done < "${_tmp}/raw"

if [ "${_bad_modes}" -gt 0 ]; then
    _fail "${_bad_modes} file(s) with invalid mode in the Git Index."
fi

### --------------------------------
### Shell Scripts Syntax Check (staged *.sh)
### --------------------------------
if [ -s "${_tmp}/sh.list" ]; then
    echo "  ↳ Validating shell scripts syntax (sh -n)..."
    _bad_sh=0
    while IFS="${_tab}" read -r _sha _f; do
        git cat-file blob "${_sha}" > "${_tmp}/script" \
            || _fail "Could not read staged blob for ${_f}."

        _shell="sh"
        _first="$(sed -n '1p' "${_tmp}/script")"
        case "${_first}" in
            *bash*)
                if command -v bash > "/dev/null" 2>&1; then
                    _shell="bash"
                fi
                ;;
        esac

        if ! _out="$("${_shell}" -n "${_tmp}/script" 2>&1)"; then
            echo "❌ [pre-commit] Syntax error in ${_f} (${_shell} -n):" >&2
            printf '%s\n' "${_out}" | sed 's/^/    /' >&2
            _bad_sh=$((_bad_sh + 1))
        fi
    done < "${_tmp}/sh.list"

    if [ "${_bad_sh}" -gt 0 ]; then
        _fail "${_bad_sh} shell script(s) with syntax errors."
    fi
fi

### --------------------------------
### Markdown Prettier Validation (staged *.md)
### --------------------------------
if [ -s "${_tmp}/md.list" ]; then
    if ! command -v prettier > "/dev/null" 2>&1; then
        echo "  ↳ Skipping Markdown validation (prettier not found)."
    else
        echo "  ↳ Validating staged Markdown files with Prettier..."
        _bad_md=0
        while IFS="${_tab}" read -r _sha _f; do
            git cat-file blob "${_sha}" > "${_tmp}/md.in" \
                || _fail "Could not read staged blob for ${_f}."

            if ! prettier --stdin-filepath "${_f}" \
                < "${_tmp}/md.in" > "${_tmp}/md.out" 2> "${_tmp}/md.err"; then
                echo "❌ [pre-commit] Prettier failed on ${_f}:" >&2
                sed 's/^/    /' "${_tmp}/md.err" >&2
                _bad_md=$((_bad_md + 1))
            elif ! cmp -s "${_tmp}/md.in" "${_tmp}/md.out"; then
                echo "❌ [pre-commit] Unformatted Markdown file: ${_f}" >&2
                _bad_md=$((_bad_md + 1))
            fi
        done < "${_tmp}/md.list"

        if [ "${_bad_md}" -gt 0 ]; then
            echo "    Run 'prettier --write <file>' and stage it again (git add)." >&2
            exit 1
        fi
    fi
fi

### --------------------------------
### Emacs Batch Startup Validation
### --------------------------------
if [ "${PRECOMMIT_SKIP_EMACS:-0}" = "1" ]; then
    echo "  ↳ Skipping Emacs batch validation (PRECOMMIT_SKIP_EMACS=1)."
elif ! command -v emacs > "/dev/null" 2>&1; then
    echo "  ↳ Skipping Emacs batch validation (emacs not found)."
elif [ ! -f "init.el" ]; then
    echo "  ↳ Skipping Emacs batch validation (init.el not found)."
else
    echo "  ↳ Validating Emacs batch configuration load..."
    mkdir "${_tmp}/emacs"

    _timeout_cmd=""
    _secs="${PRECOMMIT_EMACS_TIMEOUT:-60}"
    if command -v timeout > "/dev/null" 2>&1; then
        _timeout_cmd="timeout ${_secs}"
    elif command -v gtimeout > "/dev/null" 2>&1; then
        _timeout_cmd="gtimeout ${_secs}"
    fi

    set -- -Q --batch \
        --eval '(setq user-emacs-directory (getenv "PRECOMMIT_EMACS_DIR"))'
    if [ -f "early-init.el" ]; then
        set -- "$@" -l "${_repo_root}/early-init.el"
    fi
    set -- "$@" -l "${_repo_root}/init.el" \
        --eval '(message "Emacs pre-commit batch OK")'

    _rc=0
    (
        unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
            GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
        GIT_TERMINAL_PROMPT=0
        PRECOMMIT_EMACS_DIR="${_tmp}/emacs/"
        export GIT_TERMINAL_PROMPT PRECOMMIT_EMACS_DIR
        exec ${_timeout_cmd} emacs "$@"
    ) < "/dev/null" > "${_tmp}/emacs.log" 2>&1 || _rc=$?

    _guard_bare "após carregar o Emacs"

    if [ "${_rc}" -ne 0 ]; then
        if [ "${_rc}" -eq 124 ]; then
            echo "❌ [pre-commit] Emacs batch timed out after ${_secs}s!" >&2
        else
            echo "❌ [pre-commit] Emacs batch initialization failed (exit ${_rc})!" >&2
        fi
        echo "    Last lines of the Emacs log:" >&2
        tail -n 40 "${_tmp}/emacs.log" | sed 's/^/    /' >&2
        exit 1
    fi
fi

echo "✅ [pre-commit] All Emacs quality gates passed cleanly!"
exit 0
